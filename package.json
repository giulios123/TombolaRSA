{
  "name": "tombola-rsa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "generate:documentation": "node scripts/generate-user-documentation.mjs",
    "predev": "node scripts/generate-user-documentation.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/generate-user-documentation.mjs",
    "preview": "vite preview",
    "preview:dist": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "pretest": "node scripts/generate-user-documentation.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "data:validate": "vitest run src/data/cardValidation.test.ts src/data/dataConsistency.test.ts",
    "data:validate:sample": "vitest run src/data/cardValidation.test.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "data:render:sample": "node scripts/data-bootstrap/render-source.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/node": "24.2.1",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
